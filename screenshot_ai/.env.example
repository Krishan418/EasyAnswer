# Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Model used for image analysis
GEMINI_MODEL=gemini-3.5-flash

# Shortcuts
HOTKEY=ctrl+shift+s
TOGGLE_HOTKEY=ctrl+~
QUIT_HOTKEY=ctrl+shift+q

# Stealth & Auto-Exit
SHOW_TRAY_ICON=false
AUTO_EXIT_MINUTES=15

# Notifications
ENABLE_NOTIFICATIONS=true
NOTIFICATION_DURATION_MS=4000

# Snipping Tool support
CLIPBOARD_ON_HOTKEY=true
WATCH_COMMON_FOLDERS=false
WATCH_FOLDER=

# Start minimized
START_MINIMIZED=false

# Optional Fallback Providers (Used if Gemini is blocked on campus/lab networks)
# 1. GitHub Models (Recommended: Free GPT-4o-mini, never blocked on university networks)
# GITHUB_TOKEN=ghp_your_token_here
# GITHUB_MODEL=gpt-4o-mini

# 2. xAI Grok Fallback
# GROK_API_KEY=
# GROK_MODEL=grok-2-vision-1212

# 3. OpenRouter Fallback
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=qwen/qwen-2.5-vl-72b-instruct:free
