# Primary AI Provider (openrouter / mistral / cloudflare / huggingface / perplexity / groq / github / gemini / grok)
PRIMARY_PROVIDER=openrouter

# 1. OpenRouter (Recommended: 100% Free Vision, auto-fallback to openrouter/free)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free

# 2. Mistral AI (Free Pixtral 12B Vision - unblocked on academic networks)
# MISTRAL_API_KEY=
# MISTRAL_MODEL=pixtral-12b-2409

# 3. Cloudflare Workers AI (10k requests/day 100% free - never blocked on campus firewalls)
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_MODEL=@cf/meta/llama-3.2-11b-vision-instruct

# 4. Hugging Face Serverless Vision (Free token at huggingface.co/settings/tokens)
# HUGGINGFACE_API_TOKEN=
# HUGGINGFACE_MODEL=meta-llama/Llama-3.2-11B-Vision-Instruct

# 5. Google Gemini (15 RPM free, built-in backup)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# 6. Groq Cloud (Ultra fast)
GROQ_API_KEY=
GROQ_MODEL=llama-3.2-11b-vision-preview

# 7. Perplexity AI
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar

# 8. GitHub Models
GITHUB_TOKEN=
GITHUB_MODEL=gpt-4o-mini

# 9. xAI Grok
GROK_API_KEY=
GROK_MODEL=grok-2-vision-1212

# Shortcuts
HOTKEY=ctrl+shift+s
TOGGLE_HOTKEY=ctrl+~
QUIT_HOTKEY=ctrl+shift+q

# Stealth, Ghost Mode & Auto-Exit
SHOW_TRAY_ICON=false
AUTO_EXIT_MINUTES=15
AUTO_SHOW_POPUP=false

# Stealth Window Dimensions & Opacity
POPUP_WIDTH=260
POPUP_HEIGHT=85
POPUP_OPACITY=0.82

# Notifications
ENABLE_NOTIFICATIONS=false
NOTIFICATION_DURATION_MS=4000

# Snipping Tool support
CLIPBOARD_ON_HOTKEY=true
WATCH_COMMON_FOLDERS=false
WATCH_FOLDER=

# Start minimized
START_MINIMIZED=false
