# Primary AI Provider (openrouter / perplexity / groq / github / gemini / grok)
PRIMARY_PROVIDER=openrouter

# 1. OpenRouter (Recommended: Free Vision Models, unblocked on campus/lab networks)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free

# 2. Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# 3. Groq Cloud (Ultra fast)
GROQ_API_KEY=
GROQ_MODEL=llama-3.2-11b-vision-preview

# 4. Perplexity AI
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar

# 5. GitHub Models
GITHUB_TOKEN=
GITHUB_MODEL=gpt-4o-mini

# 6. xAI Grok
GROK_API_KEY=
GROK_MODEL=grok-2-vision-1212

# Shortcuts
HOTKEY=ctrl+shift+s
TOGGLE_HOTKEY=ctrl+~
QUIT_HOTKEY=ctrl+shift+q

# Stealth & Auto-Exit
SHOW_TRAY_ICON=false
AUTO_EXIT_MINUTES=15

# Stealth Window Dimensions & Opacity
POPUP_WIDTH=260
POPUP_HEIGHT=85
POPUP_OPACITY=0.88

# Notifications
ENABLE_NOTIFICATIONS=true
NOTIFICATION_DURATION_MS=4000

# Snipping Tool support
CLIPBOARD_ON_HOTKEY=true
WATCH_COMMON_FOLDERS=false
WATCH_FOLDER=

# Start minimized
START_MINIMIZED=false
