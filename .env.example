# =====================================================================
# DeskLens - Configuration Template
# =====================================================================

# Primary AI Provider (gemini / cloudflare / ovh / nvidia)
PRIMARY_PROVIDER=gemini

# 1. Google Gemini (Main Provider - 1,500 Requests Free/Day, 95%+ MCQ Accuracy, Unblocked on Lab Networks)
# Get your free API key at: https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3-flash-preview

# 2. Cloudflare Workers AI (1st Backup - 10,000 Free Neurons/Day, Unblocked Everywhere)
# Get your free Account ID & API Token at: https://dash.cloudflare.com
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
CLOUDFLARE_MODEL=@cf/meta/llama-3.2-11b-vision-instruct

# 3. OVHcloud Kepler (2nd Backup - 100% Free & Keyless Vision AI Safety Net)
# Built-in Qwen2.5-VL-72B-Instruct. No API key or setup required!
ENABLE_OVH=true

# 4. NVIDIA NIM (3rd Backup - Fast Llama-3.2-11B-Vision, 1000 Free Credits)
# Get your free API key at: https://build.nvidia.com
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_MODEL=meta/llama-3.2-11b-vision-instruct

# Shortcuts
HOTKEY=ctrl+shift+s
TOGGLE_HOTKEY=ctrl+~
QUIT_HOTKEY=ctrl+shift+q

# Stealth & Ghost Mode
# AUTO_SHOW_POPUP=false: Screenshot is imported & analyzed in background while remaining hidden.
# Press Ctrl+~ anytime to toggle window visibility stealthily.
SHOW_TRAY_ICON=false
AUTO_EXIT_MINUTES=0
AUTO_SHOW_POPUP=false
START_MINIMIZED=true
ENABLE_NOTIFICATIONS=false

# Window Styling & Dimensions
POPUP_WIDTH=260
POPUP_HEIGHT=85
POPUP_OPACITY=0.70

# Snipping Tool Support
CLIPBOARD_ON_HOTKEY=true
WATCH_COMMON_FOLDERS=false

# Performance & Timeouts
HTTP_CONNECT_TIMEOUT=3.5
HTTP_READ_TIMEOUT=45.0
