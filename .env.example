# =====================================================================
# DeskLens - Configuration Template
# =====================================================================

# Primary AI Provider (nvidia / ovh / groq / openrouter)
PRIMARY_PROVIDER=nvidia

# 1. NVIDIA NIM (Main Provider - Flagship Llama-3.2-90B-Vision, 1000 Free Credits, Unblocked on Lab Networks)
# Get your free API key at: https://build.nvidia.com
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_MODEL=meta/llama-3.2-90b-vision-instruct

# 2. OVHcloud Kepler (1st Backup - 100% Free & Keyless Vision AI - Unblocked on Campus/Lab Networks)
# Built-in Qwen2.5-VL-72B-Instruct. No API key or setup required!
ENABLE_OVH=true

# 3. Groq Cloud (2nd Backup - Super Fast Vision AI)
# Get your free API key at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.2-11b-vision-preview

# 4. OpenRouter (3rd Backup / Fallback)
# Get your free API key at: https://openrouter.ai
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Shortcuts
HOTKEY=ctrl+shift+s
TOGGLE_HOTKEY=ctrl+~
QUIT_HOTKEY=ctrl+shift+q

# Stealth & Ghost Mode
# AUTO_SHOW_POPUP=false: Screenshot is imported & analyzed in background while remaining hidden.
# Press Ctrl+~ anytime to toggle window visibility stealthily.
SHOW_TRAY_ICON=false
AUTO_EXIT_MINUTES=0
AUTO_SHOW_POPUP=false
START_MINIMIZED=true
ENABLE_NOTIFICATIONS=false

# Window Styling & Dimensions
POPUP_WIDTH=260
POPUP_HEIGHT=85
POPUP_OPACITY=0.70

# Snipping Tool Support
CLIPBOARD_ON_HOTKEY=true
WATCH_COMMON_FOLDERS=false

# Performance & Timeouts
HTTP_CONNECT_TIMEOUT=3.5
HTTP_READ_TIMEOUT=20.0

